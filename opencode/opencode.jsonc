{
  "$schema": "https://opencode.ai/config.json",
  // V2 permits external paths by default; retain V1's confirmation behavior.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Require an explicit decision before destructive or privileged shell operations.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
  ],
  "references": {
    "covers-betting": {
      "path": "~/nssmp/repos/covers-betting",
      "description": "Covers Betting application; see its AGENTS.md for build and test guidance.",
    },
    "covers": {
      "path": "~/nssmp/repos/covers",
      "description": "Covers.com site and CMS API; see its AGENTS.md for repo structure and setup.",
    },
    "sports-platform-cms": {
      "path": "~/nssmp/repos/sports-platform-cms",
      "description": "Sports Platform CMS; see its AGENTS.md and scoped GitHub instructions.",
    },
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      },
      "aws": {
        "type": "local",
        "disabled": true,
        "command": [
          "uvx",
          "mcp-proxy-for-aws==1.6.4",
          "https://aws-mcp.us-east-1.api.aws/mcp",
        ],
      },
      "directus_local": {
        "type": "local",
        "command": ["npx", "-y", "@directus/content-mcp@latest"],
        "environment": {
          "DIRECTUS_URL": "http://localhost:8055",
          "DIRECTUS_TOKEN": "{env:DIRECTUS_LOCAL_TOKEN}",
        },
      },
      // "directus_covers_cmsp_dev": {
