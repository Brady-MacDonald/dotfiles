    "lsp": true,
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "llama3.2": {
                    "name": "Llama 3.2"
                },
                "freehuntx/qwen3-coder:8b": {
                    "name": "Qwen3-Coder 8B"
                }
            }
        }
    },
}
